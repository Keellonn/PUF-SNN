{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "puf-snn-credential-verifier-evaluation-v1",
  "title": "Safe formal verifier attempt (no secret-bearing fields)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_manifest_sha256", "source_artifact_sha256", "source_id", "source_row_number", "condition", "phase", "sweep_index", "measurement_noise_std", "simulation_seed", "device_id", "device_index", "enrollment_id", "attempt_number", "reconstruction_outcome", "evaluator_label", "verification_invoked", "verification_calls", "verifier_result", "verification_latency_ns", "admission_result", "archived_reconstruction_ns", "composite_latency_ns"],
  "properties": {
    "schema_version": {"const": "puf-snn-credential-verifier-evaluation-v1"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_row_number": {"type": "integer", "minimum": 1, "maximum": 84000},
    "condition": {"enum": ["Nominal", "Sweep SD 0.0", "Sweep SD 0.05", "Sweep SD 0.1", "Sweep SD 0.25", "Sweep SD 0.5", "Sweep SD 1.0"]},
    "phase": {"enum": ["baseline", "noise_sweep"]},
    "sweep_index": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 5}, {"const": ""}]},
    "measurement_noise_std": {"type": "number", "minimum": 0},
    "simulation_seed": {"type": "integer"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "device_index": {"type": "integer"},
    "enrollment_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "attempt_number": {"type": "integer", "minimum": 0},
    "reconstruction_outcome": {"enum": ["decoder_failure", "invalid_format_or_padding", "candidate_valid_format"]},
    "evaluator_label": {"enum": ["correct", "wrong", "not_checked"]},
    "verification_invoked": {"type": "boolean"},
    "verification_calls": {"enum": [0, 1]},
    "verifier_result": {"enum": ["not_checked", "verified", "credential_mismatch", "record_missing", "record_disabled", "unsupported_record", "key_unavailable", "binding_mismatch", "invalid_input", "internal_error"]},
    "verification_latency_ns": {"type": ["integer", "null"], "minimum": 0},
    "admission_result": {"enum": ["not_checked", "admitted", "rejected"]},
    "archived_reconstruction_ns": {"type": "integer", "minimum": 0},
    "composite_latency_ns": {"type": ["integer", "null"], "minimum": 0}
  }
}
