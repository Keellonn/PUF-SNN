{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Candidate contract pending independent review. $defs/block is the planned-block schema; $defs/enrollment is identity-only. Canonical hash exclusions and numeric rules are specified in shared_noise_final_plan_v1.py. JSON schema checks structure; validate_plan additionally checks complete exact schedule, IDs, seeds, aliases, pairing and hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "contract_status",
    "experiment_id",
    "mode",
    "scientific_execution_authorized",
    "config_sha256",
    "rng",
    "enrollments",
    "blocks",
    "counts",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "week9-shared-noise-final-v1:plan"
    },
    "contract_version": {
      "const": "shared-noise-final-planning-v1"
    },
    "contract_status": {
      "const": "implementation-candidate-pending-independent-review"
    },
    "experiment_id": {
      "const": "week9-shared-noise-final-v1"
    },
    "mode": {
      "const": "planning-only"
    },
    "scientific_execution_authorized": {
      "const": false
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "python_version",
        "generator",
        "schedule_algorithm",
        "offset_algorithm"
      ],
      "properties": {
        "implementation": {
          "const": "CPython"
        },
        "python_version": {
          "type": "string",
          "pattern": "^3\\.(12|13)\\.\\d+$"
        },
        "generator": {
          "const": "random.Random/MT19937"
        },
        "schedule_algorithm": {
          "const": "Random.shuffle"
        },
        "offset_algorithm": {
          "const": "Random.randrange(2)"
        }
      }
    },
    "enrollments": {
      "type": "array",
      "minItems": 120,
      "maxItems": 120,
      "items": {
        "$ref": "#/$defs/enrollment"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 36000,
      "maxItems": 36000,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "counts": {
      "const": {
        "groups": 20,
        "simulated_devices": 120,
        "planned_enrollments": 120,
        "matched_trials": 36000,
        "arm_attempts": 108000,
        "blocks_per_condition": 6000,
        "attempts_per_condition": 18000,
        "attempts_per_policy": 36000
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "noise_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_seed",
        "population_id",
        "device_id",
        "noise_domain_id",
        "attempt_id",
        "model_version"
      ],
      "properties": {
        "master_seed": {
          "const": 2026102811
        },
        "population_id": {
          "type": "string",
          "pattern": "^w9f-p0[01][0-9]$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^w9f-p0[01][0-9]-d0[0-5]$"
        },
        "noise_domain_id": {
          "enum": [
            "week9-shared-noise-final-v1:enrollment-v1",
            "week9-shared-noise-final-v1:op:r000",
            "week9-shared-noise-final-v1:op:r050",
            "week9-shared-noise-final-v1:op:r090",
            "week9-shared-noise-final-v1:op:r100",
            "week9-shared-noise-final-v1:nominal:s010:r000"
          ]
        },
        "attempt_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 49
        },
        "model_version": {
          "const": "puf-snn-correlated-noise-v1"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "condition",
        "trial_id",
        "policy",
        "policy_attempt_id",
        "execution_index",
        "reading_indices",
        "noise_shared_seed_sha256",
        "reading_seed_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "week9-shared-noise-final-v1:planned-attempt"
        },
        "experiment_id": {
          "const": "week9-shared-noise-final-v1"
        },
        "condition": {
          "enum": [
            "op_rho000",
            "op_rho050",
            "op_rho090",
            "op_rho100",
            "nominal_s010",
            "common_mode_op_rho000"
          ]
        },
        "trial_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy": {
          "enum": [
            "single-read-v1",
            "majority-3-v1",
            "stored-provisioned-v1"
          ]
        },
        "policy_attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 107999
        },
        "reading_indices": {
          "enum": [
            [
              0
            ],
            [
              0,
              1,
              2
            ],
            []
          ]
        },
        "noise_shared_seed_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reading_seed_sha256": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "single-read-v1"
              }
            }
          },
          "then": {
            "properties": {
              "reading_indices": {
                "const": [
                  0
                ]
              },
              "reading_seed_sha256": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "noise_shared_seed_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "majority-3-v1"
              }
            }
          },
          "then": {
            "properties": {
              "reading_indices": {
                "const": [
                  0,
                  1,
                  2
                ]
              },
              "reading_seed_sha256": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "noise_shared_seed_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "stored-provisioned-v1"
              }
            }
          },
          "then": {
            "properties": {
              "reading_indices": {
                "const": []
              },
              "reading_seed_sha256": {
                "type": "array",
                "minItems": 0,
                "maxItems": 0,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "noise_shared_seed_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "config_sha256",
        "population_id",
        "device_id",
        "enrollment_id",
        "condition",
        "attempt_index",
        "sigma",
        "rho",
        "common_offset",
        "noise_identity",
        "noise_shared_seed_sha256",
        "reading_seed_sha256",
        "common_offset_seed_sha256",
        "linked_operating_trial_id",
        "trial_id",
        "policy_order",
        "block_index",
        "attempts"
      ],
      "properties": {
        "schema_version": {
          "const": "week9-shared-noise-final-v1:planned-block"
        },
        "experiment_id": {
          "const": "week9-shared-noise-final-v1"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "population_id": {
          "type": "string",
          "pattern": "^w9f-p0[01][0-9]$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^w9f-p0[01][0-9]-d0[0-5]$"
        },
        "enrollment_id": {
          "type": "string",
          "pattern": "^w9f-p0[01][0-9]-d0[0-5]-enroll-v1$"
        },
        "condition": {
          "enum": [
            "op_rho000",
            "op_rho050",
            "op_rho090",
            "op_rho100",
            "nominal_s010",
            "common_mode_op_rho000"
          ]
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 49
        },
        "sigma": {
          "enum": [
            0.15,
            0.1
          ]
        },
        "rho": {
          "enum": [
            0.0,
            0.5,
            0.9,
            1.0
          ]
        },
        "common_offset": {
          "enum": [
            -1,
            0,
            1
          ]
        },
        "noise_identity": {
          "$ref": "#/$defs/noise_identity"
        },
        "noise_shared_seed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reading_seed_sha256": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "common_offset_seed_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "linked_operating_trial_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "trial_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_order": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "single-read-v1",
              "majority-3-v1",
              "stored-provisioned-v1"
            ]
          },
          "uniqueItems": true
        },
        "block_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35999
        },
        "attempts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "condition": {
                "const": "op_rho000"
              }
            }
          },
          "then": {
            "properties": {
              "sigma": {
                "const": 0.15
              },
              "rho": {
                "const": 0.0
              },
              "common_offset": {
                "enum": [
                  0
                ]
              },
              "noise_identity": {
                "properties": {
                  "noise_domain_id": {
                    "const": "week9-shared-noise-final-v1:op:r000"
                  }
                }
              },
              "common_offset_seed_sha256": {
                "type": "null"
              },
              "linked_operating_trial_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "condition": {
                "const": "op_rho050"
              }
            }
          },
          "then": {
            "properties": {
              "sigma": {
                "const": 0.15
              },
              "rho": {
                "const": 0.5
              },
              "common_offset": {
                "enum": [
                  0
                ]
              },
              "noise_identity": {
                "properties": {
                  "noise_domain_id": {
                    "const": "week9-shared-noise-final-v1:op:r050"
                  }
                }
              },
              "common_offset_seed_sha256": {
                "type": "null"
              },
              "linked_operating_trial_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "condition": {
                "const": "op_rho090"
              }
            }
          },
          "then": {
            "properties": {
              "sigma": {
                "const": 0.15
              },
              "rho": {
                "const": 0.9
              },
              "common_offset": {
                "enum": [
                  0
                ]
              },
              "noise_identity": {
                "properties": {
                  "noise_domain_id": {
                    "const": "week9-shared-noise-final-v1:op:r090"
                  }
                }
              },
              "common_offset_seed_sha256": {
                "type": "null"
              },
              "linked_operating_trial_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "condition": {
                "const": "op_rho100"
              }
            }
          },
          "then": {
            "properties": {
              "sigma": {
                "const": 0.15
              },
              "rho": {
                "const": 1.0
              },
              "common_offset": {
                "enum": [
                  0
                ]
              },
              "noise_identity": {
                "properties": {
                  "noise_domain_id": {
                    "const": "week9-shared-noise-final-v1:op:r100"
                  }
                }
              },
              "common_offset_seed_sha256": {
                "type": "null"
              },
              "linked_operating_trial_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "condition": {
                "const": "nominal_s010"
              }
            }
          },
          "then": {
            "properties": {
              "sigma": {
                "const": 0.1
              },
              "rho": {
                "const": 0.0
              },
              "common_offset": {
                "enum": [
                  0
                ]
              },
              "noise_identity": {
                "properties": {
                  "noise_domain_id": {
                    "const": "week9-shared-noise-final-v1:nominal:s010:r000"
                  }
                }
              },
              "common_offset_seed_sha256": {
                "type": "null"
              },
              "linked_operating_trial_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "condition": {
                "const": "common_mode_op_rho000"
              }
            }
          },
          "then": {
            "properties": {
              "sigma": {
                "const": 0.15
              },
              "rho": {
                "const": 0.0
              },
              "common_offset": {
                "enum": [
                  -1,
                  1
                ]
              },
              "noise_identity": {
                "properties": {
                  "noise_domain_id": {
                    "const": "week9-shared-noise-final-v1:op:r000"
                  }
                }
              },
              "common_offset_seed_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "linked_operating_trial_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "population_id",
        "device_id",
        "enrollment_id",
        "noise_identity",
        "manufacturing_seed_sha256",
        "reference_seed_sha256",
        "credential_seed_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "week9-shared-noise-final-v1:planned-enrollment"
        },
        "experiment_id": {
          "const": "week9-shared-noise-final-v1"
        },
        "population_id": {
          "type": "string",
          "pattern": "^w9f-p0[01][0-9]$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^w9f-p0[01][0-9]-d0[0-5]$"
        },
        "enrollment_id": {
          "type": "string",
          "pattern": "^w9f-p0[01][0-9]-d0[0-5]-enroll-v1$"
        },
        "noise_identity": {
          "allOf": [
            {
              "$ref": "#/$defs/noise_identity"
            },
            {
              "properties": {
                "noise_domain_id": {
                  "const": "week9-shared-noise-final-v1:enrollment-v1"
                },
                "attempt_id": {
                  "const": 0
                }
              }
            }
          ]
        },
        "manufacturing_seed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference_seed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "credential_seed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
