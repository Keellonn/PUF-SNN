{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconstruction alternatives ordinary/interrupted attempt; explicit FORMAL/NONFORMAL mode",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "block_id": {
      "type": "integer",
      "minimum": 0
    },
    "slot": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "population_seed": {
      "type": "integer",
      "minimum": 0
    },
    "device_index": {
      "type": "integer",
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "generation": {
      "const": 0
    },
    "read_count": {
      "type": "integer",
      "minimum": 0
    },
    "t": {
      "type": "integer",
      "minimum": 0
    },
    "credential_entropy_bits": {
      "type": "integer",
      "minimum": 0
    },
    "selected_bit_count": {
      "type": "integer",
      "minimum": 0
    },
    "started_perf_ns": {
      "type": "integer",
      "minimum": 0
    },
    "total_ns": {
      "type": "integer",
      "minimum": 0
    },
    "read_ns": {
      "type": "integer",
      "minimum": 0
    },
    "vote_ns": {
      "type": "integer",
      "minimum": 0
    },
    "reconstruction_ns": {
      "type": "integer",
      "minimum": 0
    },
    "verification_ns": {
      "type": "integer",
      "minimum": 0
    },
    "raw_ber_numerator": {
      "type": "integer",
      "minimum": 0
    },
    "raw_ber_denominator": {
      "type": "integer",
      "minimum": 0
    },
    "first_read_errors": {
      "type": "integer",
      "minimum": 0
    },
    "effective_errors": {
      "type": "integer",
      "minimum": 0
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "week6-reconstruction-alternatives-v1"
    },
    "schema": {
      "const": "reconstruction-alternatives-attempt-v1"
    },
    "mode": {
      "enum": [
        "NONFORMAL",
        "FORMAL"
      ]
    },
    "group": {
      "enum": [
        "B0",
        "A1",
        "A2",
        "B1"
      ]
    },
    "condition": {
      "enum": [
        "nominal",
        "stress"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "trial_plan_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "noise_std": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "raw_ber": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "effective_ber": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verifier_invoked": {
      "type": "boolean"
    },
    "vote_invoked": {
      "type": "boolean"
    },
    "legitimate_admitted": {
      "type": "boolean"
    },
    "read_labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "responses64": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[01]{64}$"
      }
    },
    "effective_response64": {
      "type": "string",
      "pattern": "^[01]{64}$"
    },
    "raw_errors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 63
      }
    },
    "execution_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "reconstruction_outcome": {
      "enum": [
        "decoder_failure",
        "invalid_format_or_padding",
        "candidate_valid_format"
      ]
    },
    "decoder_status": {
      "enum": [
        "decoded",
        "uncorrectable"
      ]
    },
    "reported_correction_count": {
      "type": "integer",
      "minimum": -1,
      "maximum": 6
    },
    "candidate_message": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^([01]{30}|[01]{36})$"
        }
      ]
    },
    "candidate_credential_hex": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      ]
    },
    "padding_valid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifier_outcome": {
      "enum": [
        "not_invoked",
        "verified",
        "credential_mismatch",
        "record_missing",
        "record_disabled",
        "unsupported_record",
        "key_unavailable",
        "binding_mismatch",
        "invalid_input",
        "internal_error"
      ]
    },
    "outcome": {
      "enum": [
        "C",
        "D",
        "I",
        "W"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "enrollment_id",
        "reconstruction_id"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "enrollment_id": {
          "type": "string",
          "minLength": 1
        },
        "reconstruction_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start_ns",
          "end_ns"
        ],
        "properties": {
          "name": {
            "enum": [
              "read",
              "vote",
              "reconstruction",
              "verification"
            ]
          },
          "start_ns": {
            "type": "integer",
            "minimum": 0
          },
          "end_ns": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "mode",
    "trial_id",
    "execution_error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_error": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "block_id",
          "slot",
          "population_seed",
          "device_index",
          "attempt",
          "generation",
          "read_count",
          "t",
          "credential_entropy_bits",
          "selected_bit_count",
          "started_perf_ns",
          "total_ns",
          "read_ns",
          "vote_ns",
          "reconstruction_ns",
          "verification_ns",
          "raw_ber_numerator",
          "raw_ber_denominator",
          "first_read_errors",
          "effective_errors",
          "trial_id",
          "version",
          "schema",
          "mode",
          "group",
          "condition",
          "source_id",
          "trial_plan_sha256",
          "config_sha256",
          "plan_sha256",
          "noise_std",
          "raw_ber",
          "effective_ber",
          "verifier_invoked",
          "vote_invoked",
          "legitimate_admitted",
          "read_labels",
          "responses64",
          "effective_response64",
          "raw_errors",
          "execution_error",
          "reconstruction_outcome",
          "decoder_status",
          "reported_correction_count",
          "candidate_message",
          "candidate_credential_hex",
          "padding_valid",
          "failure_reason",
          "verifier_outcome",
          "outcome",
          "binding",
          "stages"
        ]
      },
      "else": {
        "properties": {
          "execution_error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "FORMAL"
          }
        }
      },
      "then": {
        "properties": {
          "trial_plan_sha256": {
            "const": "d22e5eebe6ec55c9f890e02b4f010833e4f32ff9d64b5c777b22e9f794a26f10"
          },
          "config_sha256": {
            "const": "3b7caa56bf296aaa02bca8fea69d545d6f1395c9811770c6e4d19ad8ea94c18b"
          },
          "plan_sha256": {
            "const": "0206983264278f1485b36bdbff29463afe2dc153aa003954506e68e75b9ced2d"
          },
          "population_seed": {
            "type": "integer",
            "minimum": 2026100701,
            "maximum": 2026100720
          },
          "device_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 49
          },
          "block_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11999
          },
          "trial_id": {
            "pattern": "^w6ra-v1:[0-9]+:(B0|A1|A2|B1)$"
          },
          "read_labels": {
            "items": {
              "type": "string",
              "pattern": "^w6ra-v1:read:20261007[0-9]{2}:[0-5]:0:(nominal|stress):[0-9]+:[0-4]$"
            }
          }
        }
      }
    }
  ]
}
