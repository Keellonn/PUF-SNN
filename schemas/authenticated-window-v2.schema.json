{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protected",
    "authentication"
  ],
  "properties": {
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "bytes_b64"
      ],
      "properties": {
        "encoding": {
          "const": "puf-snn-binary32-be-v2"
        },
        "bytes_b64": {
          "type": "string",
          "minLength": 6348,
          "maxLength": 6688,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "tag_hex"
      ],
      "properties": {
        "algorithm": {
          "const": "HMAC-SHA-256"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "tag_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUF-SNN binary authenticated envelope v2",
  "description": "Transport shape only. Strict byte parser additionally checks 16384-byte bound, duplicate keys, canonical base64 pad bits and binary representation; this schema cannot authenticate a packet."
}