{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tier 1 research attempt v1 (not operational audit)",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["sessions", "active_by_device"],
      "properties": {
        "active_by_device": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{32}$"}},
        "sessions": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["session_id", "state", "accepted_count", "last_accepted", "deadline_ns", "owner", "terminal_reason", "terminal_time_ns"],
          "properties": {
            "session_id": {"$ref": "#/$defs/sid"},
            "state": {"enum": ["ACTIVE", "PENDING", "CLOSED", "EXPIRED", "FAILED", null]},
            "accepted_count": {"$ref": "#/$defs/nullableInteger"},
            "last_accepted": {"$ref": "#/$defs/nullableInteger"},
            "deadline_ns": {"$ref": "#/$defs/nullableInteger"},
            "owner": {"type": ["string", "null"]},
            "terminal_reason": {"type": ["string", "null"]},
            "terminal_time_ns": {"$ref": "#/$defs/nullableInteger"}
          }
        }}
      }
    }
  },
  "required": [
    "result_schema_version", "trial_id", "trial_group_id", "trial_index", "trial_role",
    "attack_set_version", "attack_type", "attack_variant", "is_legitimate_control", "is_primary",
    "experiment_seed", "source_device_id", "target_device_id", "source_session_id", "target_session_id",
    "source_sequence", "mutated_field", "mutation_description", "mutation",
    "original_authenticated_bytes_sha256", "mutated_authenticated_bytes_sha256",
    "expected_decision", "expected_reason", "actual_decision", "actual_reason", "authentication_result", "order_result",
    "state_before", "state_after", "verifier_state_before", "verifier_state_after",
    "accepted_count_before", "accepted_count_after", "last_accepted_before", "last_accepted_after",
    "payload_release_attempted", "payload_released", "payload_reached_release", "payload_reached_inference",
    "release_callback_count", "exact_payload_release", "release_error", "verifier_auth_ns", "sender_prepare_ns",
    "sender_hmac_ns", "total_layer3_ns", "audit_event_id", "verifier_event_id", "run_id", "config_sha256",
    "baseline_manifest_sha256", "source_hashes", "input_artifact_sha256", "source_record_id", "temperature",
    "state_mutation_violation", "payload_release_violation", "invariant_violations", "unexpected_behavior",
    "audit_records_added", "original_envelope_b64", "submitted_envelope_b64", "lifecycle_terminal_state", "lifecycle_terminal_reason"
  ],
  "properties": {
    "result_schema_version": {"const": "puf-snn-tier1-attempt-v1"},
    "trial_id": {"type": "string", "minLength": 1},
    "trial_group_id": {"type": "string", "minLength": 1},
    "trial_index": {"type": "integer", "minimum": 0},
    "trial_role": {"enum": ["attack", "legitimate_control"]},
    "attack_set_version": {"const": "puf-snn-tier1-attacks-v1"},
    "attack_type": {"enum": ["legitimate_control", "same_session_replay", "prior_session_replay", "cross_device_substitution", "payload_modification", "metadata_modification", "cross_session_substitution"]},
    "attack_variant": {"type": "string", "minLength": 1},
    "is_legitimate_control": {"type": "boolean"},
    "is_primary": {"type": "boolean"},
    "experiment_seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "source_device_id": {"type": "string"},
    "target_device_id": {"type": ["string", "null"]},
    "source_session_id": {"$ref": "#/$defs/sid"},
    "target_session_id": {"$ref": "#/$defs/sid"},
    "source_sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "mutated_field": {"type": ["string", "null"]},
    "mutation_description": {"type": "string"},
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "operation", "byte_offset", "before_hex", "after_hex", "sample_index", "component", "bit"],
      "properties": {
        "field": {"type": ["string", "null"]}, "operation": {"type": "string"},
        "byte_offset": {"$ref": "#/$defs/nullableInteger"},
        "before_hex": {"type": ["string", "null"], "pattern": "^[0-9a-f]+$"},
        "after_hex": {"type": ["string", "null"], "pattern": "^[0-9a-f]+$"},
        "sample_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 119},
        "component": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "bit": {"type": ["integer", "null"], "minimum": 0, "maximum": 22}
      }
    },
    "original_authenticated_bytes_sha256": {"$ref": "#/$defs/hash"},
    "mutated_authenticated_bytes_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "expected_decision": {"enum": ["accept", "reject"]},
    "expected_reason": {"enum": ["accepted", "duplicate_sequence", "inactive_session", "invalid_tag"]},
    "actual_decision": {"enum": ["accept", "reject"]},
    "actual_reason": {"type": "string", "minLength": 1},
    "authentication_result": {"enum": ["pass", "fail", "not_checked", null]},
    "order_result": {"enum": ["pass", "duplicate", "stale", "gap", "not_checked", null]},
    "state_before": {"$ref": "#/$defs/state"}, "state_after": {"$ref": "#/$defs/state"},
    "verifier_state_before": {"$ref": "#/$defs/state"}, "verifier_state_after": {"$ref": "#/$defs/state"},
    "accepted_count_before": {"$ref": "#/$defs/nullableInteger"}, "accepted_count_after": {"$ref": "#/$defs/nullableInteger"},
    "last_accepted_before": {"$ref": "#/$defs/nullableInteger"}, "last_accepted_after": {"$ref": "#/$defs/nullableInteger"},
    "payload_release_attempted": {"type": "boolean"}, "payload_released": {"type": "boolean"},
    "payload_reached_release": {"type": "boolean"}, "payload_reached_inference": {"type": "boolean"},
    "release_callback_count": {"type": "integer", "minimum": 0}, "exact_payload_release": {"type": "boolean"},
    "release_error": {"type": ["string", "null"]},
    "verifier_auth_ns": {"$ref": "#/$defs/nullableInteger"}, "sender_prepare_ns": {"$ref": "#/$defs/nullableInteger"},
    "sender_hmac_ns": {"$ref": "#/$defs/nullableInteger"}, "total_layer3_ns": {"$ref": "#/$defs/nullableInteger"},
    "audit_event_id": {"type": ["string", "null"]}, "verifier_event_id": {"type": ["string", "null"]},
    "run_id": {"type": "string"}, "config_sha256": {"$ref": "#/$defs/hash"},
    "baseline_manifest_sha256": {"$ref": "#/$defs/hash"},
    "source_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "input_artifact_sha256": {"$ref": "#/$defs/hash"}, "source_record_id": {"type": "string"},
    "temperature": {"enum": ["cold", "warmup", "warm"]},
    "state_mutation_violation": {"type": "boolean"}, "payload_release_violation": {"type": "boolean"},
    "invariant_violations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unexpected_behavior": {"type": "boolean"}, "audit_records_added": {"type": "integer", "minimum": 0},
    "original_envelope_b64": {"type": "string", "minLength": 1, "maxLength": 21848},
    "submitted_envelope_b64": {"type": "string", "minLength": 1, "maxLength": 21848},
    "lifecycle_terminal_state": {"enum": ["CLOSED", "EXPIRED", "FAILED", "PENDING", null]},
    "lifecycle_terminal_reason": {"type": ["string", "null"]}
  }
}