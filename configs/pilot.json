{
  "project": {
    "name": "PUF-SNN",
    "specification_version": "0.3",
    "random_seed": 7
  },
  "task": {
    "labels": [
      "nod",
      "shake",
      "look_left_return",
      "look_right_return",
      "still"
    ],
    "prompt_seconds": 1.0,
    "action_seconds": 2.0,
    "rest_seconds": 1.0
  },
  "capture": {
    "source": "synthetic",
    "target_sample_rate_hz": 60,
    "samples_per_window": 120,
    "windowing": "fixed_nonoverlapping",
    "coordinate_frame": "unity_device_origin",
    "maximum_timestamp_gap_ms": 50.0,
    "minimum_tracking_valid_fraction": 0.95,
    "quaternion_norm_tolerance": 0.0001
  },
  "synthetic_data": {
    "device_profiles": 6,
    "sessions_per_device": 3,
    "trials_per_class_per_session": 20,
    "output_path": "data/generated/synthetic-windows.jsonl"
  },
  "synthetic_motion": {
    "generation_method": "variable_fixed_grid_v1",
    "parameter_status": "provisional engineering assumptions; not calibrated human or Quest motion",
    "resampling_applied": false,
    "tracking_valid_probability": 1.0,
    "round_decimal_places": 8,
    "session_spacing_seconds": 10000,
    "trial_amplitude_scale_range": [0.25, 1.40],
    "motion_duration_s_range": [0.80, 1.90],
    "start_delay_s_range": [0.00, 0.55],
    "phase_warp_range_rad": [-0.70, 0.70],
    "peak_timing_fraction_range": [0.25, 0.75],
    "secondary_axis_scale_range": [-0.65, 0.65],
    "return_error_std_deg": 3.0,
    "position_noise_std_m": 0.0030,
    "position_drift_std_m": 0.006,
    "position_sway_amplitude_m_range": [0.0010, 0.0060],
    "orientation_noise_std_deg": 0.60,
    "orientation_drift_std_deg": 3.00,
    "orientation_sway_amplitude_deg_range": [0.50, 4.00],
    "start_position_m_range": [-0.20, 0.20],
    "start_orientation_deg_range": [-12.0, 12.0],
    "device_effects": {
      "enabled": true,
      "amplitude_scale_std": 0.10,
      "duration_scale_std": 0.08
    },
    "session_effects": {
      "enabled": true,
      "amplitude_scale_std": 0.12,
      "duration_scale_std": 0.10
    },
    "classes": {
      "nod": {
        "rotation_axis": "x",
        "peak_rotation_deg": -22.0,
        "cycles_per_action": 1.0,
        "vertical_position_peak_m": 0.006
      },
      "shake": {
        "rotation_axis": "y",
        "peak_rotation_deg": 20.0,
        "cycles_per_action": 1.0,
        "horizontal_position_peak_m": 0.004
      },
      "look_left_return": {
        "rotation_axis": "y",
        "peak_rotation_deg": -32.0,
        "trajectory": "half_sine_return"
      },
      "look_right_return": {
        "rotation_axis": "y",
        "peak_rotation_deg": 32.0,
        "trajectory": "half_sine_return"
      },
      "still": {
        "rotation_axis": "y",
        "orientation_random_walk_step_std_deg": 0.20,
        "position_random_walk_step_std_m": 0.00030
      }
    }
  },
  "splits": {
    "primary_claim": "cross_session",
    "train_session_index": 1,
    "validation_session_index": 2,
    "test_session_index": 3,
    "group_key": "source_trial_id"
  },
  "models": {
    "input_channels": 7,
    "time_steps": 120,
    "conventional_baselines": [
      "logistic_regression",
      "random_forest"
    ],
    "conventional_settings": {
      "input_channels": 7,
      "features_per_window": 840,
      "random_seed": 2026,
      "random_seeds": [7, 17, 27, 37, 47],
      "logistic_regression": {
        "standardize_features": true,
        "solver": "lbfgs",
        "maximum_iterations": 5000
      },
      "random_forest": {
        "trees": 300,
        "processing_threads": 1
      }
    },
    "lightgbm_status": "deferred_until_initial_baselines_work",
    "snn": {
      "status": "ready_for_three_seed_baseline",
      "input_channels": 7,
      "encoding": "direct_continuous",
      "hidden_lif_neurons": 64,
      "beta": 0.9,
      "output_classes": 5,
      "learning_rate": 0.001,
      "batch_size": 32,
      "maximum_epochs": 50,
      "early_stopping_patience": 8,
      "random_seeds": [7, 17, 27]
    },
    "anomaly": {
      "design": "separate_supervised_binary_detector",
      "initial_models": [
        "logistic_regression",
        "random_forest"
      ],
      "validation_false_positive_target": 0.05
    }
  },
  "success_criteria": {
    "tier1_observed_rejection_rate": 1.0,
    "tier1_cases_per_attack": 1000,
    "maximum_valid_window_false_reject_rate": 0.005,
    "maximum_authentication_macro_f1_loss_points": 1.0,
    "maximum_snn_baseline_gap_points": 5.0,
    "authentication_p95_ms": 1.0,
    "post_window_decision_p95_ms": 20.0,
    "maximum_relative_authentication_overhead": 0.10
  }
}
