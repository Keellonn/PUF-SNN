{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authorization_id",
    "approval_sha256",
    "approval",
    "run_id",
    "output_directory",
    "config_sha256",
    "consumed_at",
    "fixture_only",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "week9-shared-noise-calibration-v1:consumption-v1"
    },
    "status": {
      "const": "consumed-before-worker-launch"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "approval_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval": {
      "type": "object"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "output_directory": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "consumed_at": {
      "type": "string",
      "minLength": 1
    },
    "fixture_only": {
      "type": "boolean"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
