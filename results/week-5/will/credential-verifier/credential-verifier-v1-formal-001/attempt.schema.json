{
  "$id": "puf-snn-credential-verifier-evaluation-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_result": {
      "enum": [
        "not_checked",
        "admitted",
        "rejected"
      ]
    },
    "archived_reconstruction_ns": {
      "minimum": 0,
      "type": "integer"
    },
    "attempt_number": {
      "minimum": 0,
      "type": "integer"
    },
    "composite_latency_ns": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "condition": {
      "enum": [
        "Nominal",
        "Sweep SD 0.0",
        "Sweep SD 0.05",
        "Sweep SD 0.1",
        "Sweep SD 0.25",
        "Sweep SD 0.5",
        "Sweep SD 1.0"
      ]
    },
    "device_id": {
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "device_index": {
      "type": "integer"
    },
    "enrollment_id": {
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "evaluator_label": {
      "enum": [
        "correct",
        "wrong",
        "not_checked"
      ]
    },
    "measurement_noise_std": {
      "minimum": 0,
      "type": "number"
    },
    "phase": {
      "enum": [
        "baseline",
        "noise_sweep"
      ]
    },
    "reconstruction_outcome": {
      "enum": [
        "decoder_failure",
        "invalid_format_or_padding",
        "candidate_valid_format"
      ]
    },
    "schema_version": {
      "const": "puf-snn-credential-verifier-evaluation-v1"
    },
    "simulation_seed": {
      "type": "integer"
    },
    "source_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_row_number": {
      "maximum": 84000,
      "minimum": 1,
      "type": "integer"
    },
    "sweep_index": {
      "oneOf": [
        {
          "maximum": 5,
          "minimum": 0,
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "verification_calls": {
      "enum": [
        0,
        1
      ]
    },
    "verification_invoked": {
      "type": "boolean"
    },
    "verification_latency_ns": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "verifier_result": {
      "enum": [
        "not_checked",
        "verified",
        "credential_mismatch",
        "record_missing",
        "record_disabled",
        "unsupported_record",
        "key_unavailable",
        "binding_mismatch",
        "invalid_input",
        "internal_error"
      ]
    }
  },
  "required": [
    "schema_version",
    "source_manifest_sha256",
    "source_artifact_sha256",
    "source_id",
    "source_row_number",
    "condition",
    "phase",
    "sweep_index",
    "measurement_noise_std",
    "simulation_seed",
    "device_id",
    "device_index",
    "enrollment_id",
    "attempt_number",
    "reconstruction_outcome",
    "evaluator_label",
    "verification_invoked",
    "verification_calls",
    "verifier_result",
    "verification_latency_ns",
    "admission_result",
    "archived_reconstruction_ns",
    "composite_latency_ns"
  ],
  "title": "Safe formal verifier attempt (no secret-bearing fields)",
  "type": "object"
}
